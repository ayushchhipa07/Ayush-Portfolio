{
  "name": "ayush_portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "homepage": "https://ayushchhipa-codes.onrender.com/",
  "scripts": {
    "postinstall": "npm ci --prefix server --omit=dev",
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro check && astro build",
    "lint": "astro check && eslint .",
    "preview": "astro preview --host 127.0.0.1",
    "start": "node server/server.js",
    "test:server": "node --test server/app.test.js",
    "test": "node scripts/audit.mjs",
    "audit:lighthouse": "node scripts/lighthouse.mjs",
    "check:launch": "node scripts/check-launch.mjs",
    "build:publish": "npm run check:launch && npm run build",
    "test:contact": "node scripts/test-contact.mjs",
    "format": "prettier --write src scripts astro.config.mjs eslint.config.js"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "lighthouse": "^13.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3"
  }
}
