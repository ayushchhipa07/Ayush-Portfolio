PUBLIC_SITE_URL=https://ayushchhipa-codes.onrender.com
# Set these only after Ayush approves the final content and identity.
IDENTITY_APPROVED=false
COMPLYRELAX_APPROVED=false
METRICS_APPROVED=false
# Optional override; defaults to the latest supplied /Ayush-Chhipa-Resume.docx.
# Place any replacement PDF or DOCX in public/ before changing this path.
PUBLIC_RESUME_PATH=
# Same-origin endpoint served by npm start. An approved separate API can be
# configured with its HTTPS URL, with CLIENT_ORIGIN set on that server.
PUBLIC_CONTACT_ENDPOINT=/api/contact
