---
import { projects } from '../data/site';
---

<div class="project-grid" role="region" aria-label="Featured project cards" tabindex="0">
  {projects.map((project) => {
    const url = project.github || project.live!;
    const linkLabel = project.github ? 'View on GitHub' : 'View live website';
    return (
      <article class="project" id={project.id} aria-labelledby={`${project.id}-heading`}>
        <div class="project-body">
          <div class="project-header">
            <div class="project-title">
              <h3 id={`${project.id}-heading`}>{project.name}</h3>
              <p class="project-role">{project.role}</p>
            </div>
            <div class="project-logo">
              {project.image ? (
                <img
                  src={project.imageSmall}
                  srcset={`${project.imageSmall} 468w, ${project.image} 936w`}
                  sizes="(max-width: 639px) 56px, 64px"
                  width={project.imageWidth}
                  height={project.imageHeight}
                  loading="lazy"
                  decoding="async"
                  alt={project.imageAlt}
                />
              ) : (
                <svg width="42" height="48" viewBox="0 0 42 48" fill="none" aria-hidden="true">
                  <path d="M9 3h16l10 10v32H9V3Z" stroke="#176c63" stroke-width="2" />
                  <path
                    d="M25 3v11h10M16 23h12M16 30h12M16 37h7"
                    stroke="#176c63"
                    stroke-width="2"
                  />
                </svg>
              )}
            </div>
          </div>
          <p class="project-subtitle">{project.subtitle}</p>
          {project.timeline && (
            <p class="project-meta">
              <span>{project.timeline}</span>
              <span class="project-status">{project.status}</span>
            </p>
          )}
          <p class="project-description">{project.preview?.description || project.description}</p>
          <ul class="project-features" aria-label={`${project.name} features`}>
            {(project.preview?.features || project.features).map((feature) => (
              <li>
                <span aria-hidden="true">✓</span>
                {feature}
              </li>
            ))}
          </ul>
          {project.preview && (
            <details class="project-more project-disclosure">
              <summary>
                <span class="show-more">Show more</span>
                <span class="show-less">Show less</span>
                <span class="disclosure-icon" aria-hidden="true">
                  +
                </span>
              </summary>
              <div class="project-expanded">
                <p class="project-description">{project.description}</p>
                <ul class="project-features" aria-label={`${project.name} detailed features`}>
                  {project.features.map((feature) => (
                    <li>
                      <span aria-hidden="true">✓</span>
                      {feature}
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          )}
          <details class="project-tech project-disclosure">
            <summary>
              Technology stack{' '}
              <span class="disclosure-icon" aria-hidden="true">
                +
              </span>
            </summary>
            <ul class="project-stack" aria-label={`${project.name} technology stack`}>
              {project.stack.map((technology) => (
                <li>{technology}</li>
              ))}
            </ul>
          </details>
        </div>
        <div class="project-footer">
          <a
            class="button project-live"
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${linkLabel}: ${project.name} (opens in a new tab)`}
          >
            {linkLabel} <span aria-hidden="true">↗</span>
          </a>
          <span class="project-domain">{new URL(url).hostname}</span>
        </div>
      </article>
    );
  })}
</div>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .project {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: 6px;
    scroll-margin-top: var(--anchor-offset);
  }

  .project-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    width: 100%;
    margin-bottom: 24px;
  }

  .project-title {
    min-width: 0;
  }

  .project-logo {
    display: grid;
    place-items: center;
    width: 84px;
    height: 64px;
    flex-shrink: 0;
    padding: 10px;
    background: #f7f7f7;
    border-radius: 4px;
  }

  .project-logo img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 100%;
    object-fit: contain;
  }

  .project-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 24px;
    padding-bottom: 0;
  }

  .project-role {
    margin: 10px 0 0;
    color: var(--gold);
    font-size: 0.78rem;
  }

  h3 {
    font-size: 1.6rem;
  }

  .project-subtitle {
    margin: 0 0 10px;
    max-width: 43ch;
    font-size: 1rem;
    line-height: 1.5;
  }

  .project-description {
    color: var(--muted);
    font-size: 0.91rem;
    max-width: 60ch;
    margin-bottom: 22px;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin: 0 0 16px;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .project-status {
    color: var(--gold);
  }

  .project-disclosure {
    width: 100%;
    border-top: 1px solid var(--line);
  }

  .project-disclosure summary {
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 52px;
    padding-block: 13px;
    font-size: 0.83rem;
    list-style: none;
  }

  .project-disclosure summary::-webkit-details-marker {
    display: none;
  }

  .project-disclosure .disclosure-icon {
    font-size: 1.2rem;
    color: var(--teal);
  }

  .project-disclosure[open] .disclosure-icon {
    transform: rotate(45deg);
  }

  .project-more .show-less,
  .project-more[open] .show-more {
    display: none;
  }

  .project-more[open] .show-less {
    display: inline;
  }

  .project-expanded {
    padding-top: 8px;
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    list-style: none;
    padding: 0;
    margin: 0 0 18px;
  }

  .project-stack li {
    padding: 6px 9px;
    background: var(--surface);
    color: var(--teal);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .project-features {
    padding: 0;
    margin: 0 0 22px;
    list-style: none;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.65;
  }

  .project-features li + li {
    margin-top: 8px;
  }

  .project-features li {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .project-features li > span {
    color: var(--teal);
    flex-shrink: 0;
  }

  .project-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding: 20px 24px 24px;
  }

  .project-domain {
    color: var(--muted);
    font-size: 0.75rem;
  }

  @media (max-width: 1023px) {
    .project-grid {
      gap: 12px;
    }

    .project-body {
      padding: 18px 16px 0;
    }

    .project-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }

    h3 {
      font-size: 1.4rem;
    }

    .project-footer {
      padding: 18px 16px;
    }

    .project-live {
      width: 100%;
      padding-inline: 10px;
      gap: 8px;
    }
  }

  @media (max-width: 639px) {
    .project-grid {
      grid-template-columns: repeat(3, minmax(280px, 1fr));
      gap: 16px;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      padding-bottom: 12px;
      scrollbar-color: var(--teal) var(--surface);
    }

    .project {
      scroll-snap-align: start;
    }

    .project-header {
      flex-direction: row;
      align-items: center;
    }

    .project-body {
      padding: 24px 20px 0;
    }

    .project-logo {
      width: 72px;
      height: 60px;
      padding: 8px;
    }

    .project-role {
      font-size: 0.72rem;
    }

    .project-footer {
      padding: 18px 20px 24px;
    }
  }

  @media (max-width: 360px) {
    .project-header {
      gap: 12px;
    }

    .project-logo {
      width: 72px;
      height: 60px;
      padding: 8px;
    }
  }
</style>
