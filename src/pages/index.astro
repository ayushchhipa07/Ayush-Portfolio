---
import Layout from '../layouts/Layout.astro';
import Projects from '../components/Projects.astro';
import ContactSection from '../components/ContactSection.astro';
import { site, projects } from '../data/site';

const schema = projects.map((project) => ({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': new URL(`/#${project.id}`, Astro.site).href,
  name: project.name,
  url: project.github || project.live,
  description: project.description,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  featureList: project.features,
}));
---

<Layout
  title={`Ayush Chhipa (Ayushchhipa) | ${site.title} & Full-Stack Developer`}
  description="Ayush Chhipa (Ayushchhipa) is a Software Developer in Jaipur building web applications and AI-powered products. Explore DocuGuard AI, NiyamHub, and ComplyRelax."
  schema={schema}
>
  <section id="home" class="hero shell" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <p class="hero-location">Jaipur, India · Full-stack development</p>
      <h1 id="hero-heading">
        Ayush Chhipa.
        <br />
        <em>{site.title}.</em>
      </h1>
      <p>
        Building web applications and AI-powered products with React, Node.js, and modern AI
        technologies.
      </p>
      <div class="hero-links">
        <a class="button" href="#projects">
          View my projects <span aria-hidden="true">↓</span>
        </a>
        <a class="text-link" href="#contact">
          Let’s talk <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <aside class="hero-context" aria-label="Current work">
      <p class="context-label">What I’m working on</p>
      <div class="context-item">
        <span class="context-type">Personal project · Working / Ongoing</span>
        <a href="#docuguard-ai">
          DocuGuard AI <span aria-hidden="true">↗</span>
        </a>
        <p>Learning AI through document intelligence and grounded, RAG-powered answers.</p>
      </div>
      <div class="context-item">
        <span class="context-type">At Businessnow Private Limited</span>
        <a href="#complyrelax">
          ComplyRelax <span aria-hidden="true">↗</span>
        </a>
        <p>Building and improving compliance workflows for CA and CS professionals.</p>
      </div>
      <div class="context-item">
        <span class="context-type">At Businessnow Private Limited</span>
        <a href="#niyamhub">
          NiyamHub <span aria-hidden="true">↗</span>
        </a>
        <p>A compliance platform with AI assistance, payments, and four languages.</p>
      </div>
      <a class="context-profile" href={site.github}>
        Find me on GitHub <span aria-hidden="true">↗</span>
      </a>
    </aside>
  </section>

  <section id="projects" class="section shell projects-section" aria-labelledby="projects-heading">
    <div class="section-top">
      <div>
        <h2 id="projects-heading">Featured projects.</h2>
        <p>Products I’ve built and contributed to, with the features and tools behind them.</p>
      </div>
      <a class="text-link" href="#contact">
        Start a project <span aria-hidden="true">↗</span>
      </a>
    </div>
    <Projects />
  </section>

  <section id="about" class="section shell section-divider" aria-labelledby="about-heading">
    <div class="section-top">
      <h2 id="about-heading">About Ayush Chhipa.</h2>
    </div>
    <div class="about-layout">
      <div class="prose">
        <p>
          I’m Ayush, a Software Developer focused on full-stack development at Businessnow Private
          Limited in Jaipur. I work on ComplyRelax and NiyamHub as part of my role, connecting
          frontend interfaces, backend services, and the data that keeps a product running.
        </p>
        <p>
          I enjoy taking a feature from the first idea through to a usable release. My work includes
          compliance workflows, government API integrations, multilingual interfaces, and internal
          automation.
        </p>
        <p>
          I’m actively learning Artificial Intelligence, progressing from fundamentals toward
          advanced concepts through hands-on work on DocuGuard AI. My current focus includes
          Generative AI, RAG, embeddings, vector databases, document intelligence, and AI-powered
          applications. My long-term goal is to become an AI Engineer specializing in GenAI and RAG
          development.
        </p>
        <p>
          Alongside this, I study data structures, system design, and DevOps through a learning
          platform I built for myself. I also built GameZone, a four-game Android app with offline
          leaderboards and two-player pass-and-play.
        </p>
        <div class="hero-links">
          {site.resume ? (
            <a class="button" href={site.resume} download>
              Download resume <span aria-hidden="true">↓</span>
            </a>
          ) : (
            <a
              class="button"
              href={`mailto:${site.email}?subject=${encodeURIComponent(`${site.title} resume request`)}`}
            >
              Request my resume <span aria-hidden="true">↗</span>
            </a>
          )}
          <a class="text-link" href={site.linkedin}>
            LinkedIn <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <dl class="background-list">
        <div>
          <dt>Current role</dt>
          <dd>
            Software Developer · Full-stack<span>Businessnow Private Limited</span>
          </dd>
        </div>
        <div>
          <dt>Education</dt>
          <dd>
            Bachelor of Computer Applications<span>Stani Memorial P.G. College</span>
          </dd>
        </div>
        <div>
          <dt>Certification</dt>
          <dd>
            <a class="text-link" href={site.certificate}>
              HackerRank certified <span aria-hidden="true">↗</span>
            </a>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section id="skills" class="section shell section-divider" aria-labelledby="skills-heading">
    <div class="section-top">
      <div>
        <h2 id="skills-heading">My working stack.</h2>
        <p>
          My development toolkit, alongside the AI concepts I’m learning and applying in DocuGuard
          AI.
        </p>
      </div>
    </div>
    <div class="skill-grid">
      <article>
        <h3>Frontend</h3>
        <p>Responsive interfaces, multilingual applications, and clear user flows.</p>
        <ul class="skill-tags">
          <li>React.js</li>
          <li>JavaScript</li>
          <li>Tailwind CSS</li>
          <li>HTML & CSS</li>
          <li>Vite</li>
        </ul>
      </article>
      <article>
        <h3>Backend</h3>
        <p>Application logic, authentication, databases, and API integrations.</p>
        <ul class="skill-tags">
          <li>PHP</li>
          <li>CodeIgniter</li>
          <li>Node.js</li>
          <li>Express.js</li>
          <li>REST APIs</li>
        </ul>
      </article>
      <article>
        <h3>Databases</h3>
        <p>Relational data for web products and vector storage in my current AI project.</p>
        <ul class="skill-tags">
          <li>MySQL</li>
          <li>SQL</li>
          <li>Vector Databases</li>
          <li>Qdrant</li>
        </ul>
      </article>
      <article>
        <h3>AI & GenAI</h3>
        <p>Actively learning the fundamentals and building practical, grounded AI applications.</p>
        <ul class="skill-tags">
          <li>Artificial Intelligence</li>
          <li>Generative AI</li>
          <li>LLMs</li>
          <li>RAG</li>
          <li>Embeddings</li>
        </ul>
      </article>
      <article>
        <h3>Retrieval & document AI</h3>
        <p>Applied in DocuGuard AI, with source validation and reproducible RAG evaluation.</p>
        <ul class="skill-tags">
          <li>Semantic Search</li>
          <li>Hybrid Retrieval</li>
          <li>Reranking</li>
          <li>Document Intelligence</li>
        </ul>
      </article>
      <article>
        <h3>Tools & automation</h3>
        <p>Source control, structured data processing, and browser workflows.</p>
        <ul class="skill-tags">
          <li>Git</li>
          <li>GitHub</li>
          <li>Python</li>
          <li>Playwright</li>
        </ul>
      </article>
    </div>
  </section>

  <section id="services" class="section shell section-divider" aria-labelledby="services-heading">
    <div class="section-top">
      <div>
        <h2 id="services-heading">What I can help with.</h2>
        <p>Have a product to build or an existing application to improve? Let’s work on it.</p>
      </div>
    </div>
    <div class="services-grid">
      <article>
        <h3>Full-stack development</h3>
        <p>
          Web applications and SaaS products, from the interface and database to authentication and
          payments.
        </p>
      </article>
      <article>
        <h3>Product improvements</h3>
        <p>
          New features, bug fixes, and workflow improvements for existing React, PHP, and
          CodeIgniter applications.
        </p>
      </article>
      <article>
        <h3>APIs & automation</h3>
        <p>
          Develop backend APIs, connect external services, organize application data, and automate
          repetitive work for your team.
        </p>
      </article>
      <article>
        <h3>AI-powered applications</h3>
        <p>
          Prototype web applications with AI-assisted workflows, combining full-stack development
          with the techniques I’m applying in DocuGuard AI.
        </p>
      </article>
      <article>
        <h3>GenAI & LLM integrations</h3>
        <p>
          Explore scoped GenAI integrations with streaming responses, efficient context handling,
          and clear behavior when an answer is unsupported.
        </p>
      </article>
      <article>
        <h3>RAG & document AI</h3>
        <p>
          Build and evaluate prototypes for document Q&A and semantic search, with retrieved
          evidence, source checks, and measurable retrieval quality.
        </p>
      </article>
    </div>
  </section>
  <ContactSection />
</Layout>
